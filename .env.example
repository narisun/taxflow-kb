# ─────────────────────────────────────────────────────────────────────────────
# TaxFlow AI Knowledge Base — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables map 1:1 to Settings fields in taxflow_kb/config.py.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
PG_DSN=postgresql://taxflow:taxflow_dev@localhost:5432/taxflow
POOL_MIN_CONN=2
POOL_MAX_CONN=10

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── OpenAI API ───────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# ── Synthesis / Completion Models ────────────────────────────────────────────
SYNTHESIS_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o
SYNTHESIS_TEMPERATURE=0.1
SYNTHESIS_MAX_TOKENS=1024
SYNTHESIS_MAX_CONTEXT_CHARS=8000

# ── Retrieval Tuning ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
BM25_EXTRAS=3
BM25_MIN_SCORE=0.05
MERGE_STRATEGY=augment

# ── Chunking ────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CHUNK_HARD_MAX=512

# ── Tax Year ────────────────────────────────────────────────────────────────
DEFAULT_TAX_YEAR=2025
SUPPORTED_TAX_YEARS=[2022, 2023, 2024, 2025]
