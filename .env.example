# ═════════════════════════════════════════════════════════════════════════════
# TaxFlow AI — REQUIRED environment variables
# ═════════════════════════════════════════════════════════════════════════════
#
# Copy this file to `.env` and fill in EVERY value. The application will
# refuse to start if any variable is missing — defaults and synthesized
# URLs have been removed.
#
# Loaders (in precedence order, highest wins):
#   1. Sources registered via `register_settings_source(...)` (Vault, etc.)
#   2. Process environment variables
#   3. Values from this `.env`
#
# Docker Compose reads the primitives directly; Python reads the composed
# connection URLs. Both are listed explicitly so the two stay in lock-step.
# ═════════════════════════════════════════════════════════════════════════════


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  A. Shared infrastructure primitives                                      ║
# ║     (used by docker-compose AND as inputs to composed URLs below)         ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=taxflow
POSTGRES_USER=taxflow
POSTGRES_PASSWORD=taxflow_dev

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_BROWSER_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=taxflow_dev


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  B. Composed connection URLs (required; no synthesis)                     ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# FastAPI backend (async SQLAlchemy)
APP_DATABASE_URL=postgresql+asyncpg://taxflow:taxflow_dev@localhost:5432/taxflow

# Postgres integration test DB (pytest -m integration)
TEST_DATABASE_URL=postgresql+asyncpg://taxflow:taxflow_dev@localhost:5432/taxflow_test

# KB subsystem (sync psycopg2)
PG_DSN=postgresql://taxflow:taxflow_dev@localhost:5432/taxflow

# Neo4j bolt URI
NEO4J_URI=bolt://localhost:7687


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  C. FastAPI backend (api/config.py)                                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

APP_ENV=development

# ── SQLAlchemy pool tuning ──────────────────────────────────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600

# ── Anthropic / Claude (chat + document extraction) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
CHAT_MAX_TOKENS=2048

# ── OCR strategy: cascade | claude | mock ───────────────────────────────────
OCR_EXTRACTOR=cascade

# ── PII encryption (REQUIRED) ───────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# ── Auth0 ───────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=https://api.taxflow.ai
AUTH0_CLIENT_ID=
AUTH0_REDIRECT_URI=http://localhost:3000/

# When true (development only), requests with no Bearer token resolve to a
# seeded dev user. Set to false to force real Auth0 login from the frontend.
# Always false in production (enforced by Settings.is_production).
AUTH0_ALLOW_DEV_BYPASS=true

# ── CORS (comma-separated) ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  D. RAG / Knowledge Base (taxkb/config.py)                                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── psycopg2 pool tuning ────────────────────────────────────────────────────
POOL_MIN_CONN=2
POOL_MAX_CONN=10

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# ── Synthesis / completion / judge ──────────────────────────────────────────
SYNTHESIS_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
SYNTHESIS_TEMPERATURE=0.1
SYNTHESIS_MAX_TOKENS=1500
SYNTHESIS_MAX_CONTEXT_CHARS=12000

# ── Context compression ─────────────────────────────────────────────────────
COMPRESSION_MODEL=gpt-4o-mini
COMPRESSION_MAX_CHUNKS=30
ENABLE_RERANKING=true
ENABLE_COMPRESSION=true

# ── Retrieval tuning ────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
BM25_EXTRAS=3
BM25_MIN_SCORE=0.05
MERGE_STRATEGY=augment
# LLM-powered query expansion: adds IRC sections, form numbers, synonyms
# before retrieval. Uses gpt-4o-mini (~0.3s, ~$0.0001 per query).
ENABLE_QUERY_EXPANSION=true

# ── Chunking ────────────────────────────────────────────────────────────────
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
CHUNK_HARD_MAX=512

# ── Tax year ────────────────────────────────────────────────────────────────
DEFAULT_TAX_YEAR=2025
SUPPORTED_TAX_YEARS=[2022, 2023, 2024, 2025]


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  E. Frontend (put this one in frontend/.env.local — Next.js convention)   ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
# NEXT_PUBLIC_API_URL=http://localhost:8000
